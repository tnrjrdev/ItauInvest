# Base URL da API consumida pelo Axios.
# Em dev local (vite), o proxy encaminha /api -> http://localhost:8080, entao
# o valor padrao "/api/v1" funciona sem configuracao adicional.
VITE_API_BASE_URL=/api/v1

# Alvo do proxy do Vite em desenvolvimento (opcional)
VITE_PROXY_TARGET=http://localhost:8080
