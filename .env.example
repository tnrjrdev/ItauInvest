# ============================================================================
# Variaveis de ambiente do docker-compose (copie para .env e ajuste)
# ============================================================================

# Banco de dados
DB_NAME=itau_invest
DB_USERNAME=itau
DB_PASSWORD=itau

# Seguranca / JWT
# Chave Base64 (HS256). Gere uma nova em producao, ex.:
#   openssl rand -base64 48
JWT_SECRET=b3V0clNlY3JldEtleUZvckl0YXVJbnZlc3RBcHBsaWNhdGlvbkpXVDIwMjQxMjM0NTY3ODkw
JWT_EXPIRATION_MS=3600000

# CORS (origens permitidas, separadas por virgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
